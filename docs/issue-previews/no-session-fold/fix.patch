   return async (route) => {
     const url = new URL(route.request().url());
@@ -73,7 +75,9 @@ for (const engine of (process.env.BROWSER ? [process.env.BROWSER] : ["chromium",
       assert.match(await group.locator(".summary").textContent(), lang === "zh" ? /3 个请求.*6.0k/ : /3 requests.*6.0k/);
       assert.equal(await group.locator(".cost").textContent(), "≈$0.030+", "partial totals must be marked");
       assert.equal(await page.locator("button.rt-session").filter({ hasText: "Claude Code" }).locator(".cost").textContent(), "≈$0.000", "zero price is known");
-      assert.equal(await page.locator("div.rt-session .cost").isVisible(), false, "unknown cost is omitted for legacy requests");
+      const none = page.locator(".rt-session").filter({ hasText: noSession(lang) });
+      assert.equal(await none.count(), 1);
+      assert.equal(await none.locator(".cost").isVisible(), false, "unknown cost is omitted for legacy requests");
       assert.equal(await page.locator(".rt-req").count(), 6);
 
       await group.click();
@@ -124,6 +128,89 @@ for (const engine of (process.env.BROWSER ? [process.env.BROWSER] : ["chromium",
   }
 }
 
+for (const engine of (process.env.BROWSER ? [process.env.BROWSER] : ["chromium", "webkit"])) {
+  for (const lang of ["en", "zh", "zh-TW", "ja", "de"]) for (const width of [1100, 420]) {
+    test(`${engine} ${lang} ${width}: requests with no session ID fold and unfold as a session's do`, async (t) => {
+      const browser = await (engine === "webkit" ? webkit.launch() : chromium.launch({ channel: "chromium" }));
+      const page = await browser.newPage({ viewport: { width, height: 800 }, reducedMotion: "reduce" });
+      page.setDefaultTimeout(5000);
+      const errors = [], feed = {};
+      // a routing group's classifier, asked before each turn, sends no session ID
+      const classifier = (id) => ({ ...req(id, "magpie", "", 0.001), kind: "routing" });
+      // newest first, a session's group heads the list, the classifier's second
+      const fixture = [req(1, "codex", "conversation-a", 0.01), classifier(2), req(3, "claude", "conversation-b", 0.02), classifier(4), req(5, "codex", "conversation-a", 0.01)];
+      page.on("pageerror", (e) => errors.push(e.message));
+      await page.route("**/*", serve(lang, feed, fixture));
+      t.after(async () => { feed.next?.([]); await browser.close(); });
+      await page.goto("http://magpie.test/?view=routing");
+      await reach(page, page.locator(".rt-group-by button").nth(1));
+      await page.locator(".rt-group-by button").nth(1).click();
+      await page.locator(".rt-session").nth(2).waitFor();
+      const none = page.locator(".rt-session").filter({ hasText: noSession(lang) });
+      // The request list scrolls inside the page. Wheel that list too when
+      // its second heading is clipped in a narrow window.
+      const reachNone = async () => {
+        const list = page.locator(".rt-reqs");
+        await reach(page, list);
+        await list.hover();
+        for (let i = 0; i < 20; i++) {
+          const dy = await none.evaluate((e) => {
+            const b = e.getBoundingClientRect(), box = e.parentElement.getBoundingClientRect();
+            return b.top < box.top + 4 ? -80 : b.bottom > box.bottom - 4 ? 80 : 0;
+          });
+          if (!dy) return;
+          const was = await list.evaluate((e) => e.scrollTop);
+          await page.mouse.wheel(0, dy);
+          await page.waitForFunction((top) => document.querySelector(".rt-reqs").scrollTop !== top, was);
+        }
+        assert.fail("no-session heading did not come into the request list's viewport");
+      };
+      assert.equal(await none.count(), 1);
+      assert.equal(await none.getAttribute("aria-expanded"), "true");
+      assert.equal(await none.locator(".arrow").textContent(), "▾");
+      assert.equal(await page.locator(".rt-req").count(), 5);
+
+      const tooltip = await none.locator(".nm").getAttribute("title");
+      assert(tooltip);
+      if (lang === "en" || lang === "zh") assert.match(tooltip, lang === "zh" ? /不视为同一个会话/ : /not treated as one conversation/);
+      await reachNone();
+      await none.click();
+      assert.equal(await none.getAttribute("aria-expanded"), "false");
+      assert.equal(await none.locator(".arrow").textContent(), "▸");
+      assert.equal(await page.locator(".rt-req").count(), 3, "the classifier's rows fold away, the sessions' stay");
+      assert.equal(await page.locator(".rt-session").count(), 3);
+
+      // a classifier call that comes in while folded moves its group to the
+      // top: it stays folded, under the same heading
+      const handle = await none.elementHandle();
+      for (let i = 0; i < 50 && !feed.next; i++) await page.waitForTimeout(20);
+      assert(feed.next, "long poll started");
+      feed.next([classifier(6)]);
+      await page.waitForFunction((name) => {
+        const group = document.querySelector(".rt-session");
+        return group?.querySelector(".nm").textContent === name && /^3\b/.test(group.querySelector(".session-count").textContent);
+      }, noSession(lang));
+      assert.equal(await page.locator(".rt-session").first().locator(".nm").textContent(), noSession(lang), "the newest request's group comes first");
+      assert.equal(await none.getAttribute("aria-expanded"), "false");
+      assert(await none.evaluate((e, previous) => e === previous, handle), "live update replaced the heading");
+      assert.equal(await page.locator(".rt-req").count(), 3);
+
+      // Enter activates the focused heading, as it does the other buttons
+      await reachNone();
+      await none.focus();
+      await page.keyboard.press("Enter");
+      await page.waitForFunction(() => document.querySelectorAll(".rt-req").length === 6);
+      assert.equal(await none.getAttribute("aria-expanded"), "true");
+      // still not one conversation: its name and title say so, as before
+      assert.equal(await none.locator(".nm").textContent(), noSession(lang));
+      assert.equal(await none.locator(".nm").getAttribute("title"), tooltip);
+      const fit = await page.locator(".rt-reqs").evaluate((e) => ({ client: e.clientWidth, scroll: e.scrollWidth }));
+      assert(fit.scroll <= fit.client + 1, `request list overflows at ${width}: ${JSON.stringify(fit)}`);
+      assert.deepEqual(errors, []);
+    });
+  }
+}
